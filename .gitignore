# Python / Django
__pycache__/
*.py[cod]
# Both the directory and the bare name: a pattern ending in `/` does NOT match a
# symlink to a directory, and a parallel git worktree normally symlinks these in
# rather than reinstalling them -- so `git add backend` staged the symlink itself.
.venv/
.venv
venv/
venv
*.sqlite3
backend/.env
# Root deployment env written by setup.sh / setup.ps1 (holds generated secrets).
/.env
/backups/
/.spaceworks-version
/.spaceworks-answers
/.spaceworks-layer
/.spaceworks-update.lock
staticfiles/

# Node / Vite
node_modules/
node_modules
frontend/dist/
frontend/.env

# tsc -b composite build artifacts. tsconfig.node.json now emits into
# frontend/node_modules/.tmp (already ignored) — a vite.config.js sitting beside
# vite.config.ts shadows it, because Vite resolves .js first. These two entries
# stay so a stale artifact from an older checkout can never be committed.
frontend/vite.config.js
frontend/vite.config.d.ts
*.tsbuildinfo

# Codex / agent scratch prompts + orchestration artifacts
.codex-prompt-*.txt
.cbrand*.txt
.cplan.md

# Internal planning + design docs — kept local, not published to the repo.
# Only curated user/ops docs are committed (e.g. docs/setup-for-makerspaces.md,
# docs/self-hosting.md).
# Internal feature report (per-feature rationale + managed/self-host limitations).
report/
docs/prd-*.md
docs/PLAN-prd-*.md
docs/superpowers/
docs/design/
docs/plans/
docs/*-plan.md
docs/plan-*.md
docs/HANDOVER.md

# Docker Compose local override — machine-specific dev config (ports, bind mounts).
# Each developer keeps their own; it is auto-merged by `docker compose` and must not be committed.
docker-compose.override.yml
docs/roadmap.md

# OS / editor
.DS_Store
.idea/
.vscode/

# End-to-end test artifacts (scripts/dev.sh e2e)
frontend/e2e/.seed.json
frontend/playwright-report/
frontend/test-results/
frontend/.npm-cache/
frontend/.pwa-browser/

# Test suites are committed (decision 244). Only run artefacts stay ignored.
backend/.affected-tests.txt
.pytest_cache/
.coverage
coverage/
htmlcov/
*.log
.env.local
.env.*.local
scratch/

# Editor / tool state and build-programme notes
.zed/
.impeccable/
LANE-CLOUD-AUDIT/
LANE-PROGRESS.md
LANE-CLOUD-HANDOFF.md
stage1-*.md
docs/stage1-*.md
RECONCILIATION-*.md
backend/apps/tenant_migration/RECONCILIATION-FIELDS.json
HANDOFF.md
backend/.claude/settings.local.json

# Local-only tool configs (editor lint/type-check)
ruff.toml
pyrightconfig.json

# Plans, prompts, hand-offs, lane notes and research notes never enter the repo (owner
# decision #148b). scripts/ci/check_rules.py refuses any that are tracked anyway (git add -f).
# Note-like names only: code such as HandoverWizard.tsx stays addable, and help articles
# (product content) stay addable whatever they are called.
*handoff*.md
*HANDOFF*.md
*Handoff*.md
*handoff*.txt
HANDOVER*.md
**/PLAN.md
PLAN-*.md
*-PLAN.md
docs/**/*-plan.md
LANE-*
*PROMPT*.md
*-prompt.md
*.prompt.md
/plans/
/handover/
/briefs/
/prompts/
research/
docs/design-revamp/
!frontend/src/help-content/**/*.md

# Test-tree junk that must never ship (decision 244 un-ignored backend/tests/).
# Vendored PIL/reportlab copy used by one lane to render offline; not a fixture.
backend/tests/**/.bk_e_render_deps/
# Build-programme reconciliation bundles (lane deltas, handoff JSON, tarballs, scratch id lists).
backend/tests/**/_reconciliation_artifacts/
backend/tests/**/reconciliation-*
backend/tests/**/recon-*-test-delta.zip
backend/tests/dec_be_local/be_ids.txt

# Generated at build time from the tracked catalogues (lingui compile / msgfmt).
frontend/src/locales/*/messages.js
backend/locale/**/*.mo

# Scratch diagnostics and build-programme part lists inside the test tree.
backend/tests/_diag/
backend/tests/idcards_best/*-PARTS.md

# Docs copied into the frontend Docker build context by frontend/scripts/docs-snapshot.mjs (release workflow).
frontend/docs-snapshot/
