# Opt-in control-plane access uses the socket peer for the allowlist.
@control_plane path /control /control/* /mfa/control/*
handle @control_plane {
    @control_plane_denied not remote_ip {$CONTROL_PLANE_ALLOW_CIDRS}
    respond @control_plane_denied 403
    reverse_proxy backend:8000 {
        header_up X-Forwarded-Proto https
    }
}
