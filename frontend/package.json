{
  "name": "spaceworks-frontend",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "node scripts/generate-api-client.mjs",
    "generate:locales": "node scripts/generate-locales.mjs",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict",
    "i18n:check": "node scripts/check-i18n-literals.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reportOnFailure=true --coverage.include=src/** --coverage.exclude=src/generated/** --coverage.exclude=**/*.test.* --coverage.reporter=html --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test",
    "build": "tsc -b && npm run build:bundle",
    "build:bundle": "vite build && node scripts/verify-pwa-build.mjs && node scripts/check-chunk-sizes.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "features:catalogue": "node scripts/features-catalogue/generate.mjs"
  },
  "dependencies": {
    "@lingui/core": "6.10.1",
    "@lingui/message-utils": "6.10.1",
    "@lingui/react": "6.10.1",
    "@sentry/browser": "11.11.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "^5.101.2",
    "@tracespace/core": "5.0.0-alpha.0",
    "fflate": "0.8.3",
    "firebase": "13.2.0",
    "linkedom": "0.18.13",
    "lucide-react": "1.57.0",
    "mermaid": "12.2.0",
    "occt-import-js": "0.0.23",
    "posthog-js": "1.447.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "4.0.1",
    "three": "0.186.1",
    "zxing-wasm": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "6.10.1",
    "@lingui/conf": "6.10.1",
    "@lingui/format-po": "6.10.1",
    "@lingui/vite-plugin": "6.10.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "^4.13.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "@grpc/grpc-js": "1.14.6"
  }
}
