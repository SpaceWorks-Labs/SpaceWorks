#!/usr/bin/env bash
# Local gate before commits leave this machine. The test suites are local-only
# (owner decision #108) and GitHub Actions runs only basic checks, so this hook is
# where tests actually run before a push. Enable once: scripts/dev.sh hooks
#
# Every push: repository rules (300-line ceiling, CLAUDE.md == AGENTS.md, no notes).
# Frontend changes: tsc -b, ESLint on the changed files, `vitest related` tests.
# Backend changes: the affected pytest files in the disposable test stack.
# Pushes to main also require SPACEWORKS_FULL_SUITE_PASSED=1: the full backend and
# frontend suites (the release regression) must have passed on this commit.
#
# Skip once, deliberately: SKIP_PREPUSH=1 git push
set -euo pipefail
[[ "${SKIP_PREPUSH:-0}" == 1 ]] && { echo "pre-push: skipped (SKIP_PREPUSH=1)." >&2; exit 0; }
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
base="" to_main=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue   # deleting a remote branch
  [[ "$remote_ref" == refs/heads/main ]] && to_main=1
  if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    base="$(git merge-base "$local_sha" origin/dev 2>/dev/null || git rev-parse "$local_sha~1")"
  fi
done
[[ -n "$base" ]] || exit 0

if ((to_main)) && [[ "${SPACEWORKS_FULL_SUITE_PASSED:-0}" != 1 ]]; then
  echo "pre-push: pushing to main is a release. Run the full regression first:" >&2
  echo "  scripts/dev.sh test   and   (cd frontend && npm test)" >&2
  echo "then push with SPACEWORKS_FULL_SUITE_PASSED=1." >&2
  exit 1
fi

changed="$(git diff --name-only "$base" HEAD)"
echo "pre-push: repository rules" >&2
python scripts/ci/check_rules.py

if grep -q '^frontend/' <<<"$changed"; then
  echo "pre-push: frontend type-check and lint" >&2
  (cd frontend && npx tsc -b)
  mapfile -t lint_files < <(grep -E '^frontend/.*\.(ts|tsx|js|jsx|mjs)$' <<<"$changed" \
    | sed 's#^frontend/##' | while read -r f; do [[ -f "frontend/$f" ]] && echo "$f"; done)
  if ((${#lint_files[@]})); then (cd frontend && npx eslint "${lint_files[@]}"); fi
  AFFECTED_BASE="$base" scripts/dev.sh affected frontend
fi

if grep -q '^backend/' <<<"$changed"; then
  echo "pre-push: affected backend tests" >&2
  AFFECTED_BASE="$base" scripts/dev.sh affected backend
fi
echo "pre-push: all checks passed." >&2
