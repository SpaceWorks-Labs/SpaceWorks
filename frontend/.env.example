VITE_API_URL=http://localhost:8000/api
VITE_TENANT_TOKEN=
VITE_PUBLIC_API_KEY=
VITE_PUBLIC_CLIENT_ID=

# Exact browser origins allowed for event object uploads (comma-separated).
# Empty permits same-origin uploads only; local MinIO is an explicit opt-in.
VITE_EVENT_UPLOAD_ORIGINS=http://localhost:9000
# Decorative motion and easter eggs are on unless set to false (each space can also turn them off).
VITE_UI_DELIGHT_ENABLED=true
VITE_UI_EASTER_EGGS_ENABLED=true
