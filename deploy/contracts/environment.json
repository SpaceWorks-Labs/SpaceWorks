{
  "schema_version": 1,
  "rules": {
    "missing_selectors": "host+full",
    "unknown_or_empty_selectors": "refuse_exit_78_before_Django",
    "host_free": "refused",
    "full_free_knobs": "unread_and_inert",
    "secrets": "protected mounts/provider stores; never browser, argv or logs",
    "runtime_roles": [
      "backend",
      "worker",
      "beat",
      "cron",
      "management"
    ],
    "maintenance_credentials": "finite release/adopt/qualified maintenance jobs only; never web/common anchors",
    "rotation": "validate and release/restart consumers; preserve generated continuity secrets",
    "unimplemented_names": "reserved interfaces, not proof of a runtime read"
  },
  "implemented_by_i": {
    "SPACEWORKS_DEPLOYMENT_MODE": {
      "default": "host",
      "enum": [
        "host",
        "managed"
      ],
      "secret": false,
      "roles": "all",
      "policy": "excluded"
    },
    "SPACEWORKS_DEPLOYMENT_PROFILE": {
      "default": "full",
      "enum": [
        "full",
        "free"
      ],
      "secret": false,
      "roles": "all",
      "policy": "excluded"
    },
    "CLOUD_TASK_PROFILE": {
      "default": "legacy host; derived managed",
      "enum": [
        "redis",
        "brokerless"
      ],
      "secret": false,
      "roles": "all",
      "policy": "excluded"
    },
    "CLOUD_SCHEDULER": {
      "default": "legacy host; derived managed",
      "enum": [
        "beat",
        "loop",
        "external",
        "tick"
      ],
      "secret": false,
      "roles": "all",
      "policy": "excluded"
    },
    "EMAIL_PROVIDER": {
      "default": "",
      "enum": [
        "",
        "smtp",
        "resend",
        "postmark",
        "ses",
        "brevo",
        "mailgun",
        "sendgrid"
      ],
      "secret": false,
      "roles": "mail consumers",
      "policy": "value"
    },
    "FREE_TICK_SECRET": {
      "default": "",
      "profile": "free",
      "secret": true,
      "roles": [
        "backend",
        "external trigger"
      ],
      "policy": "excluded"
    },
    "FREE_TICK_INTERVAL_SECONDS": {
      "default": 600,
      "minimum": 60,
      "maximum": 86400,
      "profile": "free",
      "secret": false,
      "roles": [
        "backend",
        "external trigger"
      ],
      "policy": "excluded"
    },
    "FREE_TICK_BUDGET_SECONDS": {
      "default": 20,
      "minimum": 1,
      "maximum": 20,
      "profile": "free",
      "secret": false,
      "roles": [
        "backend"
