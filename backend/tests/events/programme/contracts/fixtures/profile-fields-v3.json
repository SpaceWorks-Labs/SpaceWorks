{
  "contract_version": 3,
  "owner": "F",
  "implementation": "apps.forms_schema.profile_fields",
  "descriptors": [
    {
      "field_key": "name",
      "value_schema": {
        "type": "string",
        "maxLength": 200
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "phone",
      "value_schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "institution",
      "value_schema": {
        "type": "string",
        "maxLength": 200
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "organization",
      "value_schema": {
        "type": "string",
        "maxLength": 200
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "study_level",
      "value_schema": {
        "type": "string",
        "maxLength": 100
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "country",
      "value_schema": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "skills",
      "value_schema": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 60
        },
        "maxItems": 50,
        "uniqueItems": true
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "github_url",
      "value_schema": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 2048
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "linkedin_url",
      "value_schema": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 2048
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "portfolio_url",
      "value_schema": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 2048
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "resume",
      "value_schema": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "asset_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "sensitive": true,
      "default_save": false,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "shirt_size",
      "value_schema": {
        "type": "string",
        "maxLength": 32
      },
      "sensitive": false,
      "default_save": true,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "dietary_needs",
      "value_schema": {
        "type": "string",
        "maxLength": 2000
      },
      "sensitive": true,
      "default_save": false,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "accessibility_needs",
      "value_schema": {
        "type": "string",
        "maxLength": 2000
      },
      "sensitive": true,
      "default_save": false,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "emergency_contact",
      "value_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "relationship": {
            "type": "string",
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "required": [
          "name",
          "relationship",
          "phone"
        ],
        "additionalProperties": false
      },
      "sensitive": true,
      "default_save": false,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "date_of_birth",
      "value_schema": {
        "type": "string",
        "format": "date"
      },
      "sensitive": true,
      "default_save": false,
      "persistable": true,
      "all_values_encrypted": true
    },
    {
      "field_key": "age_at_event",
      "sensitive": true,
      "default_save": false,
      "persistable": false,
      "derived": true
    }
  ],
  "normalization": {
    "strings": "unicode_normalize_trim",
    "phone": "normalized_international_contact",
    "country": "valid_ISO3166_alpha2_uppercase",
    "urls": "HTTPS_no_credentials_no_fetch",
    "date_of_birth": "valid_calendar_date_not_future",
    "empty_value": "never_implies_delete",
    "mapping": "compatible_type_visible_values_only",
    "duplicate_mapping": "identical_canonical_values_or_duplicate_profile_mapping"
  }
}
