# Launch selectors are independent of MANAGED_POSTGRES and SaaS domain suffixes.
# Existing host/full defaults stay unchanged. Managed/free is a separate opt-in
# setup; see docs/deploy/cloud-contracts.md (step-1 preparation, not certification).
SPACEWORKS_DEPLOYMENT_MODE=host
SPACEWORKS_DEPLOYMENT_PROFILE=full
# CLOUD_TASK_PROFILE=redis|brokerless  # unset preserves legacy host behavior
# CLOUD_SCHEDULER=beat|loop|external  # tick is allowed only with managed+free
# EMAIL_PROVIDER=                     # unset preserves EMAIL_BACKEND below
# EMAIL_PROVIDER_CONFIG_FILE=        # protected provider config (E contract)

POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_USER=makerspace
POSTGRES_DB=makerspace_manager
POSTGRES_APP_USER=spaceworks_app
POSTGRES_APP_PASSWORD=replace-with-a-different-strong-password
SPACEWORKS_SCHEDULER_MODE=image

MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret

# Compose project/container prefix.
COMPOSE_PROJECT_NAME=spaceworks

SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=inventory.example.org
CORS_ALLOWED_ORIGINS=https://inventory.example.org
# Absolute base for links in outbound email (password reset, invitations). REQUIRED for a
# working forgot-password flow: if unset, links are emitted as bare paths such as
# "/reset-password?uid=..." which are not clickable in an email client.
PUBLIC_APP_BASE_URL=https://inventory.example.org
# Fernet key for API client, Telegram bot token, and makerspace SMTP password encryption.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_CLIENT_ENC_KEY=

# Security hardening. Leave ENABLE_HTTPS=false for the default HTTP-behind-nginx
# Docker setup. Set it to true ONLY when a proxy terminates real TLS and forwards
# X-Forwarded-Proto: https — it turns on SSL redirect, Secure cookies, and HSTS.
ENABLE_HTTPS=false
# Number of trusted reverse proxies in front of the backend, used to find the real client
# IP for rate limiting. The bundled stack has exactly one (the nginx frontend container);
# add 1 for each extra TLS proxy or CDN you put in front of it. Leaving this unset makes
# every user share a single rate-limit bucket, because the only address Django sees is
# nginx's.
TRUSTED_PROXY_COUNT=1
# Brute-force lockout (django-axes) on the Django admin login.
AXES_FAILURE_LIMIT=5

MAKERSPACE_BACKEND_IMAGE=ghcr.io/spaceworks-labs/spaceworks-backend
MAKERSPACE_FRONTEND_IMAGE=ghcr.io/spaceworks-labs/spaceworks-frontend
MAKERSPACE_IMAGE_TAG=latest
HTTP_PORT=80

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Makerspace <noreply@example.com>

# Public catalog images live in a separate anonymous-read bucket. Use this only
# for item photos and makerspace logo/cover images, never private evidence.
PUBLIC_IMAGE_BUCKET=public-images
PUBLIC_IMAGE_BASE_URL=http://localhost:9000/public-images
PUBLIC_IMAGE_MAX_BYTES=5242880
PUBLIC_IMAGE_URL_TTL_SECONDS=300

# Telegram. Per-makerspace bot tokens + group chat ids are stored (encrypted) in the
# DB; these are the optional global fallback bot and the webhook auth secret.
# TELEGRAM_WEBHOOK_SECRET authenticates the retained webhook route, which only acknowledges
# and discards callbacks; decisions are made in the staff console. Unset = rejects every call.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Browser notifications (W3C Web Push / VAPID; blank = dormant) ---
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.org

# --- Managed-Postgres / Supabase mode (all default to the self-hosted localhost behavior) ---
# See docs/supabase-deployment.md. Leave these at their defaults for the bundled
# Docker (local Postgres + MinIO) stack; set them only when hosting on Supabase et al.
#
# MANAGED_POSTGRES=true makes makerspace purge suspend immutability triggers via a
# custom GUC (no superuser) instead of session_replication_role (which Supabase forbids).
MANAGED_POSTGRES=False
# Transaction-pooler runtime (Supabase port 6543) cannot keep prepared statements or
# server-side cursors: set CONN_MAX_AGE=0 and DISABLE_SERVER_SIDE_CURSORS=True there.
# Run `manage.py migrate` against the DIRECT/session-pooler URL, not the transaction pooler.
CONN_MAX_AGE=0
DISABLE_SERVER_SIDE_CURSORS=False
# Object storage presign style. "post" = MinIO/S3 browser POST policy (default, with an
# upload-time content-length-range). "put" = Supabase Storage S3 presigned PUT (no
# upload-time size policy; the backend re-validates size server-side at attach time).
STORAGE_PRESIGN_METHOD=post
# Object expiry bounds live evidence bytes and RETAINS every evidence row (attached
# evidence metadata stays immutable). Preview policies before enabling.
# Range: 30-3650 days, batch: 1-1000.
EVIDENCE_OBJECT_RETENTION_DAYS=365
EVIDENCE_OBJECT_EXPIRY_ENABLED=False
EVIDENCE_RETENTION_BATCH_SIZE=100
# Travel support receipts/payee data and staged event form uploads (see
# docs/environment-reference.md). Out-of-range values refuse to start.
EVENT_REIMBURSEMENT_RECEIPT_RETENTION_DAYS=2555
EVENT_REIMBURSEMENT_PAYEE_PURGE_DAYS=30
EVENT_REIMBURSEMENT_FILE_MAX_BYTES=10485760
EVENT_REIMBURSEMENT_MEMBER_STORAGE_BYTES=104857600
EVENT_REIMBURSEMENT_EVENT_STORAGE_BYTES=1073741824
EVENT_STAGE_FILE_RETENTION_DAYS=365
EVENT_STAGE_MEMBER_QUOTA_BYTES=104857600
EVENT_STAGE_EVENT_QUOTA_BYTES=1073741824
# Abandoned-upload cleanup is a SEPARATE, default-off switch. It deletes only old
# post-migration presign rows proven never consumed by any workflow; attached
# issue/return/accountability evidence is never deleted. Each tenant must also opt in.
# The default age (days) must exceed EVIDENCE_URL_TTL_SECONDS. Receipts left by earlier
# cleanups keep reconciling late object writes even after this is switched off.
EVIDENCE_ABANDONED_UPLOAD_CLEANUP_ENABLED=False
EVIDENCE_ABANDONED_UPLOAD_RETENTION_DAYS=7
# Shared secret for the cron return-reminder endpoint
# (POST /api/v1/internal/cron/return-reminders, header X-Cron-Secret). The endpoint
# 404s while this is unset. Use it when you can't run `manage.py send_return_reminders`
# on a schedule (e.g. trigger from GitHub Actions / cron-job.org / pg_cron+pg_net).
CRON_SECRET=
# Observability opt-ins (all blank = off). METRICS_TOKEN enables GET /api/v1/metrics/
# (Prometheus text, bearer token); SENTRY_DSN enables error tracking with PII off.
# Every other variable the backend reads is listed in docs/environment-reference.md.
# Compose forwards these opt-ins explicitly; setting an unforwarded name has no effect.
METRICS_TOKEN=
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_ENVIRONMENT=production
# Stripe Connect OAuth callback. Leave blank in self-host mode.
STRIPE_CONNECT_REDIRECT_URI=
# Enrolled devices (printers/label printers, module `devices`). Signed requests must be
# within the skew; the nonce TTL must be at least twice the skew (devices.E003).
DEVICE_SIGNATURE_MAX_SKEW_SECONDS=300
DEVICE_ENROLLMENT_TTL_SECONDS=900
DEVICE_NONCE_TTL_SECONDS=86400

# Connected printer command delivery (phase 7b); lease covers delivery, not print duration.
DEVICE_COMMAND_LEASE_SECONDS=60
DEVICE_COMMAND_MAX_ATTEMPTS=10

# Published GitHub releases drive updates; fork owners publish their own images.
# Optional automatic deploys use the server runner; see docs/self-hosting.md#updating.
SPACEWORKS_REPOSITORY=SpaceWorks-Labs/SpaceWorks

# Station PIN hashing identity: generate once; keep unchanged through upgrades.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
EVENT_STATION_PIN_PEPPER=

# Optional deployment policy / observability (docs/environment-operations.md).
ROUTE_METRICS_ENABLED=False
# Empty for a single-process server; Compose uses /tmp/spaceworks-prometheus.
PROMETHEUS_MULTIPROC_DIR=
ORGANIZATION_SELF_CREATION_ENABLED=False
ORGANIZATION_SELF_CREATION_MAX_OWNED=3
ORGANIZATION_SELF_CREATION_MAX_PER_DAY=1
# Managed-hosting limiter (#187A), OFF by default; managed deployments only (docs/environment-reference.md).
MANAGED_PLANS_ENABLED=False
MANAGED_BILLING_ONLINE_ENABLED=False
# Opt-in manual Plausible protocol: all three values must be supplied together.
WEB_ANALYTICS_SCRIPT_URL=
WEB_ANALYTICS_COLLECT_URL=
WEB_ANALYTICS_DOMAIN=
# Frontend nginx CSP only: space-separated HTTPS API/object-storage origins.
WEB_ANALYTICS_EXTRA_CONNECT_ORIGINS=

# Personal chat OAuth returns to the frontend notification settings page.
# HTTPS only; optional {makerspace_id} and {challenge_id}; blank refuses linking.
# The backend includes ?notify_challenge=<id>; providers append code and state.
NOTIFICATION_SLACK_REDIRECT_URI=
NOTIFICATION_MATTERMOST_REDIRECT_URI=
NOTIFICATION_DISCORD_REDIRECT_URI=
NOTIFICATION_MATTERMOST_ALLOW_PRIVATE_HOSTS=False
WHATSAPP_META_GRAPH_VERSION=v25.0

# Additional managed deployment settings (host/full defaults above stay unchanged).
# DATABASE_CONNECTION_MODE=direct   # or proven session transport; never transaction
# SPACEWORKS_DEPLOYMENT_ID=<stable UUID bound by finite release/adopt>
# DATABASE_MAINTENANCE_URL=<finite release job only; never common runtime environment>
# STORAGE_CAPABILITIES_FILE=/tmp/spaceworks-secrets/storage.json
# STORAGE_CAPABILITY_TTL_SECONDS=900
# AWS_SESSION_TOKEN=<optional private temporary session token>
# EMAIL_PROVIDER=resend            # smtp,resend,postmark,ses,brevo,mailgun,sendgrid
# EMAIL_PROVIDER_CONFIG_FILE=/tmp/spaceworks-secrets/email.json
# EMAIL_PROVIDER_WEBHOOKS_ENABLED=False
# SPACEWORKS_SECRET_FILE_MODE=native # inline materializes protected base64 JSON
# SPACEWORKS_STORAGE_CAPABILITIES_B64=<provider secret; never public env>
# SPACEWORKS_EMAIL_PROVIDER_CONFIG_B64=<provider secret; never public env>
# TRUST_FORWARDED_HOST=False
# TRUSTED_EDGE_CIDRS=<verified ingress network CIDRs, no wildcard>
# TRUSTED_EDGE_UPSTREAM_HOSTS=<exact upstream Host values>
# Free only: set SPACEWORKS_DEPLOYMENT_MODE=managed and PROFILE=free explicitly.
# FREE_TICK_SECRET=<32..256 random printable bytes; backend and scheduler only>
# FREE_TICK_INTERVAL_SECONDS=600
# FREE_TICK_BUDGET_SECONDS=20
# FREE_TICK_RATE_LIMIT_PER_MINUTE=6
# FREE_TICK_INGRESS_LIMIT_PER_MINUTE=120
# FREE_MAX_PROMOTION_BYTES=16777216
# FREE_DB_CAP_BYTES=<actual account cap>
# FREE_OBJECT_CAP_BYTES=<actual account cap>
# FREE_EMAIL_ACCOUNT_KEY=<stable billing-account key>
# FREE_EMAIL_DAILY_CAP=<actual recipient allowance>
# FREE_EMAIL_MONTHLY_CAP=<only when provider imposes one; otherwise OMIT>
# FREE_EMAIL_RESET_TIMEZONE=UTC
# FREE_EMAIL_ACCOUNTS=<protected operator JSON binding tenant credential fingerprints>

# TRUSTED_EDGE_INGRESS_SECRET=<server-only edge/backend shared secret; never browser env>

# Account Saved details and Events credentials are independent, explicit opt-ins.
# Keep existing master/digest/keyring values across upgrades; never regenerate them.
# Configure secrets before enabling the vault or issuing v2 event credentials.
# See docs/environment-reference.md for key formats and previous-key custody.
ACCOUNT_SAVED_DETAILS_ENABLED=False
ACCOUNT_PII_KEY_BROKER=local
ACCOUNT_PII_MASTER_KEY=
ACCOUNT_PII_MASTER_KEY_PREVIOUS=
ACCOUNT_PII_AWS_KMS_KEY_ID=
ACCOUNT_SAVED_ASSET_BUDGET_BYTES=52428800
ACCOUNT_SAVED_RESUME_SCAN_REQUIRED=False
ACCOUNT_SAVED_RESUME_SCANNER=
EVENT_REGISTRATION_CREDENTIAL_DIGEST_KEY=
EVENT_REGISTRATION_CREDENTIAL_KEY_VERSION=1
EVENT_REGISTRATION_CREDENTIAL_KEYS={}
EVENT_ASSET_SCAN_BACKEND=none
EVENT_ASSET_CLAMAV_HOST=
EVENT_ASSET_CLAMAV_PORT=3310
UI_DELIGHT_ENABLED=True
UI_EASTER_EGGS_ENABLED=True

# --- Login security (platform defaults; a space's security policy may only tighten them) ---
# Breached-password check via the HIBP k-anonymity range API: on, 2 s timeout, fail-open.
# PASSWORD_BREACH_CHECK_ENABLED=True
# PASSWORD_BREACH_CHECK_TIMEOUT_SECONDS=2
# Cloudflare Turnstile CAPTCHA. Dormant until both keys are set (the secret is a secret).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_FAIL_MODE=open
# TURNSTILE_AFTER_FAILURES=3
# TURNSTILE_HOSTNAMES=
# Automatic IP blocking: one source failing against this many accounts within the window.
# LOGIN_IP_BLOCK_ENABLED=True
# LOGIN_IP_BLOCK_DISTINCT_ACCOUNTS=10
# LOGIN_IP_BLOCK_WINDOW_SECONDS=900
# LOGIN_IP_BLOCK_SECONDS=3600
# Unusual-login check, remembered devices, emailed login codes and "this wasn't me" links.
# LOGIN_RISK_FAILURE_THRESHOLD=3
# LOGIN_REMEMBERED_DEVICE_DAYS=90
# LOGIN_CODE_TTL_SECONDS=600
# SECURITY_ALERT_LINK_TTL_DAYS=14
# Passkeys (WebAuthn) relying-party display name.
# WEBAUTHN_RP_NAME=Space Works
# Minimum native app version per platform (x.y.z; empty = no minimum). Older apps are
# refused at device sign-in and refresh with 426 native_app_update_required.
# MIN_NATIVE_APP_VERSION_IOS=
# MIN_NATIVE_APP_VERSION_ANDROID=
