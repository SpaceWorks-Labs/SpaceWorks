{
  "$id": "https://spaceworks.invalid/schemas/device-adapter/v1/event.scan.reported.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code_type": {
      "enum": [
        "qr",
        "barcode",
        "rfid",
        "nfc"
      ],
      "type": "string"
    },
    "value": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "code_type",
    "value"
  ],
  "type": "object"
}
