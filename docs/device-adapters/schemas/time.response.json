{
  "$id": "https://spaceworks.invalid/schemas/device-adapter/v1/time.response.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kid": {
      "maximum": 1000000,
      "minimum": 1,
      "type": "integer"
    },
    "nonce": {
      "maxLength": 64,
      "minLength": 16,
      "type": "string"
    },
    "server_time": {
      "maximum": 4102444800,
      "minimum": 0,
      "type": "integer"
    },
    "signature": {
      "maxLength": 128,
      "minLength": 128,
      "type": "string"
    }
  },
  "required": [
    "server_time",
    "nonce",
    "kid",
    "signature"
  ],
  "type": "object"
}
