{
    # Permit certificates only for custom domains approved by the backend.
    on_demand_tls {
        ask http://backend:8000/api/v1/internal/tls-check
    }
}

# Shared application routing for platform and custom-domain hosts.
(backend_paths) {
    # The TLS ask endpoint is internal-only, even though it also fails closed.
    handle /api/v1/internal/* {
        respond 403
    }

    handle /api/v1/live/* {
        reverse_proxy live:8000
    }

    @profile_crawler {
        path_regexp profile_card (?i)^/([a-z0-9](?:[a-z0-9._-]{1,28}[a-z0-9]))/?$
        not path /.well-known /.well-known/* /about /about/* /admin /admin/* /api /api/* /assets /assets/* /bookings /bookings/* /checkout /checkout/* /config.js /config.js/* /control /control/* /discover /discover/* /docs /docs/* /embed /embed/* /event-check-in /event-check-in/* /events /events/* /favicon.ico /favicon.ico/* /guest-admin /guest-admin/* /health /health/* /healthz /healthz/* /index.html /index.html/* /install /install/* /items /items/* /kiosk /kiosk/* /m /m/* /machines /machines/* /media /media/* /member /member/* /member-sw.js /member-sw.js/* /mfa /mfa/* /now /now/* /o /o/* /organization-invitations /organization-invitations/* /print /print/* /redoc /redoc/* /reset-password /reset-password/* /robots.txt /robots.txt/* /scanner /scanner/* /schema /schema/* /setup /setup/* /share /share/* /sitemap.xml /sitemap.xml/* /staff /staff/* /staff-invitations /staff-invitations/* /static /static/* /stats /stats/* /superadmin /superadmin/* /sw.js /sw.js/*
        header_regexp User-Agent (?i)(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot)
    }
    handle @profile_crawler {
        rewrite * /share/profiles/{re.profile_card.1}/
        reverse_proxy backend:8000
    }

    @event_crawler {
        path_regexp event_card ^/(m/[^/]+/)?events/([0-9a-fA-F-]{36})/?$
        header_regexp User-Agent (?i)(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot)
    }
    handle @event_crawler {
        rewrite * /share/events/{re.event_card.2}/
        reverse_proxy backend:8000
    }
    @booking_crawler {
        path_regexp booking_card ^/(m/[^/]+/)?bookings/([0-9a-fA-F-]{36})/?$
        header_regexp User-Agent (?i)(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot)
    }
    handle @booking_crawler {
        rewrite * /share/bookings/{re.booking_card.2}/
        reverse_proxy backend:8000
    }

    @backend path /embed/* /share/* /sitemap.xml /robots.txt /api/* /static/* /docs/* /redoc/* /schema/*
    reverse_proxy @backend backend:8000 {
        header_up X-Forwarded-Proto https
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    reverse_proxy {$SPACEWORKS_WEB_UPSTREAM:frontend:80} {
        # Backend responses own their referrer policy (embeds and credentials use no-referrer).
        header_down Referrer-Policy strict-origin
        header_down X-Frame-Options "DENY"
        # Add framing protection without replacing the SPA analytics policy.
        header_down +Content-Security-Policy "frame-ancestors 'none'"
    }
}

# Expose the S3-compatible API through its dedicated storage hostname.
# files.space-works.tech is a *.space-works.tech subdomain, so it is served by the same static
# Cloudflare Origin CA cert (each site block manages its own TLS — without this
# Caddy would try public ACME for this host, which fails behind Cloudflare).
files.space-works.tech {
    tls /etc/caddy/certs/spaceworks.crt /etc/caddy/certs/spaceworks.key
    reverse_proxy minio:9000
}

# Platform apex and makerspace subdomains use the Cloudflare Origin CA cert.
*.space-works.tech, space-works.tech {
    tls /etc/caddy/certs/spaceworks.crt /etc/caddy/certs/spaceworks.key
    import backend_paths
}

# Verified tenant custom domains receive public certificates on demand.
https:// {
    tls {
        on_demand
    }
    import backend_paths
}
